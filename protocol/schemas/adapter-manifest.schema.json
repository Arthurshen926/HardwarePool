{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://capyio.dev/schemas/adapter-manifest-v2.json",
  "title": "CapyIO Adapter Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "version",
    "control_protocol",
    "kind",
    "deployment_modes",
    "platforms",
    "mode_bindings",
    "capability_templates",
    "integration_mode",
    "license"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$" },
    "name": { "$ref": "#/$defs/nonEmpty" },
    "version": { "$ref": "#/$defs/nonEmpty" },
    "control_protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {
        "major": { "const": 1 },
        "minor": { "type": "integer", "minimum": 0, "maximum": 65535 }
      }
    },
    "kind": {
      "enum": ["physical", "projection", "connection", "composite", "export", "panel", "mock"]
    },
    "deployment_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["in_process", "sidecar", "external_service", "driver_backed"] }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "mode_bindings": { "$ref": "#/$defs/modeBindings" },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "capability_templates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/capabilityTemplate" }
    },
    "integration_mode": { "$ref": "#/$defs/nonEmpty" },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "notice"],
      "properties": {
        "spdx": { "$ref": "#/$defs/nonEmpty" },
        "notice": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "upstream": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "$ref": "#/$defs/declaresInProcess" },
      "then": { "properties": { "mode_bindings": { "required": ["in_process"] } } },
      "else": { "properties": { "mode_bindings": { "not": { "required": ["in_process"] } } } }
    },
    {
      "if": { "$ref": "#/$defs/declaresSidecar" },
      "then": { "properties": { "mode_bindings": { "required": ["sidecar"] } } },
      "else": { "properties": { "mode_bindings": { "not": { "required": ["sidecar"] } } } }
    },
    {
      "if": { "$ref": "#/$defs/declaresExternalService" },
      "then": { "properties": { "mode_bindings": { "required": ["external_service"] } } },
      "else": { "properties": { "mode_bindings": { "not": { "required": ["external_service"] } } } }
    },
    {
      "if": { "$ref": "#/$defs/declaresDriverBacked" },
      "then": { "properties": { "mode_bindings": { "required": ["driver_backed"] } } },
      "else": { "properties": { "mode_bindings": { "not": { "required": ["driver_backed"] } } } }
    }
  ],
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "declaresInProcess": {
      "properties": { "deployment_modes": { "contains": { "const": "in_process" } } },
      "required": ["deployment_modes"]
    },
    "declaresSidecar": {
      "properties": { "deployment_modes": { "contains": { "const": "sidecar" } } },
      "required": ["deployment_modes"]
    },
    "declaresExternalService": {
      "properties": { "deployment_modes": { "contains": { "const": "external_service" } } },
      "required": ["deployment_modes"]
    },
    "declaresDriverBacked": {
      "properties": { "deployment_modes": { "contains": { "const": "driver_backed" } } },
      "required": ["deployment_modes"]
    },
    "modeBindings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "in_process": { "$ref": "#/$defs/inProcessDeployment" },
        "sidecar": { "$ref": "#/$defs/sidecarDeployment" },
        "external_service": { "$ref": "#/$defs/externalServiceDeployment" },
        "driver_backed": { "$ref": "#/$defs/driverBackedDeployment" }
      }
    },
    "inProcessDeployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindings"],
      "properties": {
        "bindings": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/nonEmpty" },
          "additionalProperties": { "$ref": "#/$defs/inProcessPlatformBinding" }
        }
      }
    },
    "inProcessPlatformBinding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "module": { "$ref": "#/$defs/nonEmpty" },
        "library": { "$ref": "#/$defs/nonEmpty" }
      },
      "anyOf": [
        { "required": ["module"] },
        { "required": ["library"] }
      ]
    },
    "sidecarDeployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoints"],
      "properties": {
        "entrypoints": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/nonEmpty" },
          "additionalProperties": { "$ref": "#/$defs/nonEmpty" }
        }
      }
    },
    "externalServiceDeployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["services"],
      "properties": {
        "services": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/nonEmpty" },
          "additionalProperties": { "$ref": "#/$defs/externalServicePlatformBinding" }
        }
      }
    },
    "externalServicePlatformBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe", "connection"],
      "properties": {
        "probe": { "$ref": "#/$defs/externalServiceProbe" },
        "connection": { "$ref": "#/$defs/externalServiceConnection" }
      }
    },
    "externalServiceProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {
        "kind": { "enum": ["tcp_connect", "http_get", "local_socket", "named_pipe"] },
        "target": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "externalServiceConnection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "endpoint"],
      "properties": {
        "kind": { "enum": ["tcp", "http", "websocket", "local_socket", "named_pipe"] },
        "endpoint": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "driverBackedDeployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bindings"],
      "properties": {
        "bindings": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/nonEmpty" },
          "additionalProperties": { "$ref": "#/$defs/driverBackedPlatformBinding" }
        }
      }
    },
    "driverBackedPlatformBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controller", "driver_dependency"],
      "properties": {
        "controller": { "$ref": "#/$defs/userModeControllerBinding" },
        "driver_dependency": { "$ref": "#/$defs/driverDependencyMetadata" }
      }
    },
    "userModeControllerBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoint", "control_interface"],
      "properties": {
        "entrypoint": { "$ref": "#/$defs/nonEmpty" },
        "control_interface": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "driverDependencyMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "version_requirement", "interface"],
      "properties": {
        "identifier": { "$ref": "#/$defs/nonEmpty" },
        "version_requirement": { "$ref": "#/$defs/nonEmpty" },
        "interface": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "capabilityTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "class", "ports"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmpty" },
        "class": { "$ref": "#/$defs/nonEmpty" },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/portTemplate" }
        }
      }
    },
    "portTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "direction", "profile", "profile_major"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmpty" },
        "direction": { "enum": ["source", "sink", "control"] },
        "profile": { "$ref": "#/$defs/nonEmpty" },
        "profile_major": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    }
  }
}
