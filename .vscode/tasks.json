{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "HardwarePool: doctor",
      "type": "shell",
      "command": "cargo xtask doctor",
      "problemMatcher": []
    },
    {
      "label": "HardwarePool: structural validation",
      "type": "shell",
      "command": "python scripts/validate_repository.py",
      "problemMatcher": []
    },
    {
      "label": "HardwarePool: Rust check",
      "type": "shell",
      "command": "cargo xtask check",
      "group": "build",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "HardwarePool: Rust tests",
      "type": "shell",
      "command": "cargo xtask test",
      "group": "test",
      "problemMatcher": ["$rustc"]
    },
    {
      "label": "HardwarePool: UI typecheck",
      "type": "shell",
      "command": "pnpm typecheck",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "HardwarePool: UI dev",
      "type": "shell",
      "command": "pnpm dev",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
