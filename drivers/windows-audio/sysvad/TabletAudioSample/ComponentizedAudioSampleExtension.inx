[Version]
Signature   = "$Windows NT$"
Class       = Extension
ClassGuid   = {e2f84ce7-8efa-411c-aa69-97454ca4cb57}
Provider    = %ProviderName%
ExtensionId = {AB84FE65-3D09-4C4B-BA5A-988CBAFF9692}
DriverVer   = 08/28/2026,21.60.0.1
CatalogFile = capyioaudio.cat
PnpLockDown = 1

[Manufacturer]
%MfgName% = CapyIOExtensions,NT$ARCH$.10.0...17763

[CapyIOExtensions.NT$ARCH$.10.0...17763]
%Device.ExtensionDesc% = CapyIOExtension_Install,Root\CapyIO_VirtualSpeaker

[CapyIOExtension_Install]

[CapyIOExtension_Install.HW]
AddReg = CapyIOExtension.FriendlyName

[CapyIOExtension.FriendlyName]
HKR,,FriendlyName,,%ExtendedFriendlyName%

[CapyIOExtension_Install.Components]
AddComponent = CapyIORenderAPO,,CapyIOApo.AddComponent
AddComponent = MsApoFxProxy,,MsApoFxProxy.AddComponent

[CapyIOApo.AddComponent]
ComponentIDs = VEN_CAPY&CID_RENDERAPO
Description = "CapyIO Render APO"

[MsApoFxProxy.AddComponent]
ComponentIDs = VEN_MSFT&CID_PROXYAPO
Description = "Microsoft Proxy APO"

[CapyIOExtension.Interface]
DelReg = CapyIOExtension.Interface.DelReg
AddReg = CapyIOExtension.Interface.AddReg

[CapyIOExtension.Interface.DelReg]
HKR,FX\0,%PKEY_CompositeFX_StreamEffectClsid%
HKR,FX\0,%PKEY_SFX_ProcessingModes_Supported_For_Streaming%
HKR,FX\0,%PKEY_CompositeFX_EndpointEffectClsid%
HKR,FX\0,%PKEY_EFX_ProcessingModes_Supported_For_Streaming%

[CapyIOExtension.Interface.AddReg]
HKR,FX\0,%PKEY_FX_Association%,,%KSNODETYPE_ANY%
HKR,FX\0,%PKEY_CompositeFX_ModeEffectClsid%,0x00010000,%CAPYIO_RENDER_MFX_CLSID%
HKR,FX\0,%PKEY_MFX_ProcessingModes_Supported_For_Streaming%,%REG_MULTI_SZ%,%AUDIO_SIGNALPROCESSINGMODE_DEFAULT%,%AUDIO_SIGNALPROCESSINGMODE_MEDIA%,%AUDIO_SIGNALPROCESSINGMODE_MOVIE%

[CapyIOExtension_Install.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,%KSNAME_TopologySpeaker%,CapyIOExtension.Interface
AddInterface = %KSCATEGORY_TOPOLOGY%,%KSNAME_TopologySpeaker%,CapyIOExtension.Interface
AddInterface = %KSCATEGORY_AUDIO%,%KSNAME_TopologyMicIn%,CapyIOMicrophoneExtension.Interface
AddInterface = %KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyMicIn%,CapyIOMicrophoneExtension.Interface
AddInterface = %KSCATEGORY_AUDIO%,%KSNAME_TopologyMicIngress%,CapyIOMicrophoneExtension.Interface
AddInterface = %KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyMicIngress%,CapyIOMicrophoneExtension.Interface

[CapyIOMicrophoneExtension.Interface]
DelReg = CapyIOMicrophoneExtension.Interface.DelReg
AddReg = CapyIOMicrophoneExtension.Interface.AddReg

[CapyIOMicrophoneExtension.Interface.DelReg]
HKR,FX\0,%PKEY_CompositeFX_StreamEffectClsid%
HKR,FX\0,%PKEY_SFX_ProcessingModes_Supported_For_Streaming%
HKR,FX\0,%PKEY_CompositeFX_EndpointEffectClsid%
HKR,FX\0,%PKEY_EFX_ProcessingModes_Supported_For_Streaming%

[CapyIOMicrophoneExtension.Interface.AddReg]
HKR,FX\0,%PKEY_FX_Association%,,%KSNODETYPE_ANY%
HKR,FX\0,%PKEY_CompositeFX_ModeEffectClsid%,0x00010000,%CAPYIO_MIC_BRIDGE_MFX_CLSID%
HKR,FX\0,%PKEY_MFX_ProcessingModes_Supported_For_Streaming%,%REG_MULTI_SZ%,%AUDIO_SIGNALPROCESSINGMODE_DEFAULT%,%AUDIO_SIGNALPROCESSINGMODE_COMMUNICATIONS%,%AUDIO_SIGNALPROCESSINGMODE_SPEECH%

[Strings]
ProviderName = "CapyIO Project"
MfgName = "CapyIO Project"
Device.ExtensionDesc = "CapyIO Speaker Extension"
ExtendedFriendlyName = "CapyIO Speaker with Render Bridge"
CAPYIO_RENDER_MFX_CLSID = "{D8D4EC87-0518-49B5-8E21-F975D2A0C210}"
CAPYIO_MIC_BRIDGE_MFX_CLSID = "{BD509A91-814F-4937-AE1F-0ACF3C7D0E64}"
