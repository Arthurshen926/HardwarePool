HKR,AudioEngine\AudioProcessingObjects\%CAPYIO_RENDER_SFX_CLSID%,"MajorVersion",0x00010001,1
HKR,AudioEngine\AudioProcessingObjects\%CAPYIO_RENDER_SFX_CLSID%,"MinorVersion",0x00010001,0
HKR,AudioEngine\AudioProcessingObjects\%CAPYIO_RENDER_SFX_CLSID%,"Flags",0x00010001,%APO_FLAG_DEFAULT%
HKR,AudioEngine\AudioProcessingObjects\%CAPYIO_RENDER_SFX_CLSID%,"MinInputConnections",0x00010001,1
HKR,AudioEngine\AudioProcessingObjects\%CAPYIO_RENDER_SFX_CLSID%,"MaxInputConnections",0x00010001,1
