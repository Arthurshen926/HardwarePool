HKR,AudioEngine\AudioProcessingObjects\%CAPYIO_RENDER_SFX_CLSID%,"NumAPOInterfaces",0x00010001,1
HKR,AudioEngine\AudioProcessingObjects\%CAPYIO_RENDER_SFX_CLSID%,"APOInterface0",,"{FD7F2B29-24D0-4B5C-B177-592C39F9CA10}"

HKR,Classes\CLSID\%CAPYIO_MIC_BRIDGE_MFX_CLSID%,,,%MicMFX.FriendlyName%
HKR,Classes\CLSID\%CAPYIO_MIC_BRIDGE_MFX_CLSID%\InProcServer32,,0x00020000,%13%\CapyIORenderAPO.dll
HKR,Classes\CLSID\%CAPYIO_MIC_BRIDGE_MFX_CLSID%\InProcServer32,ThreadingModel,,"Both"
HKR,AudioEngine\AudioProcessingObjects\%CAPYIO_MIC_BRIDGE_MFX_CLSID%,"FriendlyName",,%MicMFX.FriendlyName%
HKR,AudioEngine\AudioProcessingObjects\%CAPYIO_MIC_BRIDGE_MFX_CLSID%,"Copyright",,%Copyright%
HKR,AudioEngine\AudioProcessingObjects\%CAPYIO_MIC_BRIDGE_MFX_CLSID%,"MajorVersion",0x00010001,1
HKR,AudioEngine\AudioProcessingObjects\%CAPYIO_MIC_BRIDGE_MFX_CLSID%,"MinorVersion",0x00010001,0
HKR,AudioEngine\AudioProcessingObjects\%CAPYIO_MIC_BRIDGE_MFX_CLSID%,"Flags",0x00010001,%APO_FLAG_DEFAULT%
HKR,AudioEngine\AudioProcessingObjects\%CAPYIO_MIC_BRIDGE_MFX_CLSID%,"MinInputConnections",0x00010001,1
