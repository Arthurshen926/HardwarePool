[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
Provider    = %ProviderName%
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
DriverVer   = 08/28/2026,21.63.0.1
CatalogFile = capyioaudio.cat
PnpLockDown = 1

[SourceDisksNames]
1 = %DiskName%

[SourceDisksFiles]
CapyIOAudio.sys = 1

[SignatureAttributes]
CapyIOAudio.sys = SignatureAttributes.DRM

[SignatureAttributes.DRM]
DRMLevel = 1300

[Manufacturer]
%MfgName% = CapyIO,NT$ARCH$.10.0...17763

[CapyIO.NT$ARCH$.10.0...17763]
%CapyIO.DeviceDesc% = CapyIO_Install,Root\CapyIO_VirtualSpeaker

[DestinationDirs]
CapyIO.CopyList = 13

[CapyIO.CopyList]
CapyIOAudio.sys

[CapyIO_Install.NT]
Include = ks.inf,wdmaudio.inf
Needs = KS.Registration,WDMAUDIO.Registration,MsApoFxProxy.Registration
CopyFiles = CapyIO.CopyList
AddReg = CapyIO.AddReg,CapyIO.EndpointNames.AddReg

[CapyIO.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,CapyIOAudio.sys
HKR,Drivers,SubClasses,,"wave,midi,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%CapyIO.DeviceDesc%
HKR,Drivers\midi\wdmaud.drv,Description,,%CapyIO.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%CapyIO.DeviceDesc%

[CapyIO.EndpointNames.AddReg]
HKR,%MediaCategories%\%CapyIO.SpeakerNameGuid%,Name,,%CapyIO.SpeakerEndpointName%
HKR,%MediaCategories%\%CapyIO.MicrophoneIngressCategoryGuid%,Name,,%CapyIO.MicrophoneIngressEndpointName%
HKR,%MediaCategories%\%CapyIO.MicrophoneIngressNameGuid%,Name,,%CapyIO.MicrophoneIngressEndpointName%
HKR,%MediaCategories%\%CapyIO.MicrophoneNameGuid%,Name,,%CapyIO.MicrophoneEndpointName%

[CapyIO_Install.NT.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,%KSNAME_WaveSpeaker%,CapyIO.I.WaveSpeaker
AddInterface = %KSCATEGORY_RENDER%,%KSNAME_WaveSpeaker%,CapyIO.I.WaveSpeaker
AddInterface = %KSCATEGORY_REALTIME%,%KSNAME_WaveSpeaker%,CapyIO.I.WaveSpeaker
AddInterface = %KSCATEGORY_AUDIO%,%KSNAME_TopologySpeaker%,CapyIO.I.TopologySpeaker
AddInterface = %KSCATEGORY_TOPOLOGY%,%KSNAME_TopologySpeaker%,CapyIO.I.TopologySpeaker
AddInterface = %KSCATEGORY_AUDIO%,%KSNAME_WaveMicIngress%,CapyIO.I.WaveMicIngress
AddInterface = %KSCATEGORY_RENDER%,%KSNAME_WaveMicIngress%,CapyIO.I.WaveMicIngress
AddInterface = %KSCATEGORY_REALTIME%,%KSNAME_WaveMicIngress%,CapyIO.I.WaveMicIngress
AddInterface = %KSCATEGORY_AUDIO%,%KSNAME_TopologyMicIngress%,CapyIO.I.TopologyMicIngress
AddInterface = %KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyMicIngress%,CapyIO.I.TopologyMicIngress
AddInterface = %KSCATEGORY_AUDIO%,%KSNAME_WaveMicIn%,CapyIO.I.WaveMicIn
AddInterface = %KSCATEGORY_CAPTURE%,%KSNAME_WaveMicIn%,CapyIO.I.WaveMicIn
AddInterface = %KSCATEGORY_REALTIME%,%KSNAME_WaveMicIn%,CapyIO.I.WaveMicIn
AddInterface = %KSCATEGORY_AUDIO%,%KSNAME_TopologyMicIn%,CapyIO.I.TopologyMicIn
AddInterface = %KSCATEGORY_TOPOLOGY%,%KSNAME_TopologyMicIn%,CapyIO.I.TopologyMicIn

[CapyIO.I.WaveSpeaker]
AddReg = CapyIO.I.WaveSpeaker.AddReg

[CapyIO.I.WaveSpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%CapyIO.WaveSpeaker.Name%

[CapyIO.I.TopologySpeaker]
AddReg = CapyIO.I.TopologySpeaker.AddReg

[CapyIO.I.TopologySpeaker.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%CapyIO.TopologySpeaker.Name%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,1

[CapyIO.I.WaveMicIngress]
AddReg = CapyIO.I.WaveMicIngress.AddReg

[CapyIO.I.WaveMicIngress.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%CapyIO.WaveMicIngress.Name%

[CapyIO.I.TopologyMicIngress]
AddReg = CapyIO.I.TopologyMicIngress.AddReg

[CapyIO.I.TopologyMicIngress.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%CapyIO.TopologyMicIngress.Name%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,1

[CapyIO.I.WaveMicIn]
AddReg = CapyIO.I.WaveMicIn.AddReg

[CapyIO.I.WaveMicIn.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%CapyIO.WaveMicIn.Name%

[CapyIO.I.TopologyMicIn]
AddReg = CapyIO.I.TopologyMicIn.AddReg

[CapyIO.I.TopologyMicIn.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%CapyIO.TopologyMicIn.Name%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,1

[CapyIO_Install.NT.Services]
AddService = CapyIOAudio,0x00000002,CapyIO_Service

[CapyIO_Service]
DisplayName = %CapyIO.ServiceDesc%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %13%\CapyIOAudio.sys

[CapyIO_Install.NT.HW]
AddReg = CapyIO.Hardware

[CapyIO.Hardware]
HKR,,DeviceType,0x00010001,0x0000001D
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[CapyIO_Install.NT.Wdf]
KmdfService = CapyIOAudio,CapyIO_Wdf

[CapyIO_Wdf]
KmdfLibraryVersion = $KMDFVERSION$

